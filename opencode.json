{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "model": "opencode-go/qwen3.7-max",
  "default_agent": "orchestrator",
  "permissions": [
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "su *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "doas *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pkexec *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -fr /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf ~",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf ~/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf --no-preserve-root*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "dd *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "mkfs*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "fdisk*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "parted*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wipefs*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shutdown*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "reboot*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "poweroff*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "halt*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "init 0*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "systemctl reboot*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "systemctl poweroff*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "systemctl halt*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chmod -R 777 /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chown -R * /*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl * | sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl * | bash",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget * | sh",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget * | bash",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/Documentos/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/Downloads/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.local/share/plasma/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.ssh/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.gnupg/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.aws/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.kube/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.docker/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.password-store/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/etc/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/boot/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/sys/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/proc/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/dev/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/root/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/var/**",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        {
          "action": "shell",
          "resource": "rm -rf /tmp/opencode/*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rm -fr /tmp/opencode/*",
          "effect": "allow"
        }
      ]
    },
    "plan": {
      "model": "opencode-go/glm-5.3",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "ask"
        }
      ]
    },
    "title": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ]
      },
      "open-design": {
        "type": "local",
        "command": [
          "{env:OPEN_DESIGN_NODE}",
          "{env:OPEN_DESIGN_CLI}",
          "mcp"
        ],
        "environment": {
          "OD_DATA_DIR": "{env:OD_DATA_DIR}",
          "OD_SIDECAR_IPC_PATH": "{env:OD_SIDECAR_IPC_PATH}"
        }
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.4.0",
          "mcp"
        ],
        "environment": {
          "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
        }
      }
    }
  }
}
