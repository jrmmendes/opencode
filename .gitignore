# Dependências
node_modules/

# Variáveis de ambiente e secrets (nunca versionar)
.env
.env.*
!.env.example

# Chaves, certificados e credenciais
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
*.local
credentials.json
secrets.json
*.secret

# Ruído de SO / editores
.DS_Store
Thumbs.db
*~

# Bytecode Python
__pycache__/
*.pyc

# Estado local e backups (nunca versionar)
service.json
*.backup

# Planos são estado local (consumidos pela skill `consume-plans`); nunca versionar
.plans/

# Feedback local/global (skill `feedback`)
# Versiona só o log curado e o README; estado e relatórios são locais.
.feedbacks/*
!.feedbacks/README.md
!.feedbacks/LEARNINGS.md
